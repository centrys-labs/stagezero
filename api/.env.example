# Database
DATABASE_URL=postgres://stagezero:password@localhost:5432/stagezero

# Encryption key for secrets at rest (64 hex chars = 32 bytes AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect base (no trailing slash)
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

# Set to "false" to disable secure cookies (local dev)
COOKIE_SECURE=false

# Absolute path to the OpenSSH known_hosts file StageZero trusts for SSH host
# key verification. Connections to servers absent from this file, or whose key
# changed, are refused. See docs/security/ssh-host-key-verification.md.
SSH_KNOWN_HOSTS_FILE=
