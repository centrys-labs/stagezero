# Database
DATABASE_URL=postgres://stagezero:password@localhost:5432/stagezero

# Encryption key for secrets at rest (64 hex chars = 32 bytes AES-256)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Version-tagged or digest-pinned edge monitoring agent image
MONITORING_IMAGE=ghcr.io/wahyus002/uploy-monitor:0.1.0

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth redirect base (no trailing slash)
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

# Set to "false" to disable secure cookies (local dev)
COOKIE_SECURE=false

# Source analysis: single API replica; for multiple replicas enforce shared ingress limits.
SOURCE_ANALYSIS_REQUEST_BYTES=16384
SOURCE_ANALYSIS_TARBALL_BYTES=104857600
SOURCE_ANALYSIS_EXTRACTED_BYTES=536870912
SOURCE_ANALYSIS_OUTPUT_BYTES=1048576
SOURCE_ANALYSIS_ENTRIES=20000
SOURCE_ANALYSIS_RATE_PER_MINUTE=6
SOURCE_ANALYSIS_CONCURRENCY=2
SOURCE_ANALYSIS_TIMEOUT_SECONDS=90
